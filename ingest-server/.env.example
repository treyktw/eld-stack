# Postgres connection string (long-term store).
DATABASE_URL=postgresql://eld_ingest:change-me@localhost:5432/eld_ingest

# Bind address for the HTTP server.
BIND_ADDR=0.0.0.0:8080

# Per-device credentials. Ingest refuses to start if this map is missing,
# empty, or contains a token shorter than 32 bytes.
INGEST_DEVICE_TOKENS_JSON={"eld-development-001":"replace-with-at-least-32-random-bytes"}

# Optional durable forwarding to a downstream webhook. Set both or neither.
# Accepted events remain in Postgres's outbox while it is unavailable.
PIPELINE_URL=
PIPELINE_TOKEN=

# Log filter.
RUST_LOG=info,eld_ingest_server=debug
