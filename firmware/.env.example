# Copy to .env.local for a provisioned physical device. Do not commit the
# populated file; each ELD must have a different server-side bearer token.
ELD_UPLOAD_URL=https://ingest.example.com/ingest
ELD_UPLOAD_TOKEN=replace-with-at-least-32-random-bytes

# Uncomment only after the SIM is installed and the public HTTPS route is healthy.
# ELD_CELLULAR_UPLINK=1
